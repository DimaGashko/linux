#!/bin/bash

prompt="${1:-In:}"

while true; do
   value=$(rofi -dmenu -p "$prompt:" -l 0)

   # Esc / cancel
   if [[ $? -ne 0 ]]; then
      exit 1
   fi

   # Empty, 0 = immediately; -1 = cancel
   if [[ -z "$value" || "$value" == "0" || "$value" == "-1" ]]; then
      echo "$value"
      exit 0
   fi

   # Number only = seconds
   if [[ "$value" =~ ^[0-9]+$ ]]; then
      echo "${value}s"
      exit 0
   fi

   # Explicit unit, decimals allowed: 30s, 2.5m, 1.5h
   if [[ "$value" =~ ^[0-9]+([.][0-9]+)?[smh]$ ]]; then
      echo "$value"
      exit 0
   fi

   rofi -e "Invalid value: $value

Use: -1, 30, 30s, 2.5m, 1.5h"
done